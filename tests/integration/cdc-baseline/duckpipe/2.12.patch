From 70bdbc497e8dc7244278cbbe9be7ca8647b7a557 Mon Sep 17 00:00:00 2001
From: Christiaan Casper Viviers <25070401@sun.ac.za>
Date: Fri, 27 Nov 2026 09:20:33 +0200
Subject: [PATCH 2/2] Use pgoutput commit position for COPY catch-up admission

---
 duckpipe-core/src/service.rs | 103 ++++++++++++++++++++++++++++-------
 1 file changed, 83 insertions(+), 20 deletions(-)

diff --git a/duckpipe-core/src/service.rs b/duckpipe-core/src/service.rs
index fbbe8b7..00d7ab1 100644
--- a/duckpipe-core/src/service.rs
+++ b/duckpipe-core/src/service.rs
@@ -160,28 +160,27 @@ async fn ensure_coordinator_queue(
     Ok(())
 }

-/// Returns true if this WAL change should be skipped: disabled, errored,
-/// not yet caught up (CATCHUP with lsn <= snapshot_lsn), or already applied
-/// in append mode (lsn <= applied_lsn).
-fn should_skip_change(mapping: &TableMapping, lsn: u64) -> bool {
+/// Decide whether a DML message belongs in this mapping's queue.
+fn should_skip_change(
+    mapping: &TableMapping,
+    row_lsn: u64,
+    final_lsn: Option<u64>,
+) -> Result<bool, String> {
     if !mapping.enabled || matches!(mapping.state, SyncState::Errored) {
-        return true;
+        return Ok(true);
     }
-    if matches!(mapping.state, SyncState::Catchup)
-        && mapping.snapshot_lsn != 0
-        && lsn <= mapping.snapshot_lsn
-    {
-        return true;
+    if matches!(mapping.state, SyncState::Catchup) && mapping.snapshot_lsn != 0 {
+        // Compare the transaction's commit record start (from pgoutput BEGIN)
+        // to the decoding boundary. The DML WAL record can start right at that
+        // boundary or precede it even though the transaction commits after it.
+        let final_lsn = final_lsn.ok_or("CATCHUP DML without a pgoutput BEGIN")?;
+        return Ok(final_lsn < mapping.snapshot_lsn);
     }
-    // Append-mode exactly-once: skip already-applied WAL changes
-    if matches!(mapping.sync_mode, SyncMode::Append)
+    // Append-mode replay continues to use the stored per-change LSN.
+    Ok(matches!(mapping.sync_mode, SyncMode::Append)
         && matches!(mapping.state, SyncState::Streaming)
         && mapping.applied_lsn != 0
-        && lsn <= mapping.applied_lsn
-    {
-        return true;
-    }
-    false
+        && row_lsn <= mapping.applied_lsn)
 }

 /// Fill unchanged (TOAST) columns in `new_values` from `old_values`.
