+                    )?;
                     if mapping.source_schema == "fixture" && mapping.source_table == "order_items" {
                         let (xid, final_lsn) = transaction.unwrap_or_default();
                         tracing::debug!(
@@ -530,7 +533,11 @@ async fn process_one_wal_message(
