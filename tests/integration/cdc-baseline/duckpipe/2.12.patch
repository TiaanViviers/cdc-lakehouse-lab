+
+#[cfg(test)]
+mod copy_boundary_tests {
+    use super::*;
+
+    fn mapping(state: SyncState) -> TableMapping {
+        TableMapping {
+            id: 1,
+            source_schema: "fixture".into(),
+            source_table: "order_items".into(),
+            target_schema: "bronze".into(),
+            target_table: "order_items".into(),
+            state,
+            snapshot_lsn: 100,
+            applied_lsn: 110,
+            enabled: true,
+            source_oid: None,
+            target_oid: 0,
+            error_message: None,
+            source_label: String::new(),
+            sync_mode: SyncMode::Upsert,
+            config: Default::default(),
+        }
+    }
+
+    #[test]
+    fn catchup_admits_row_at_snapshot_point_if_commit_is_later() {
+        let map = mapping(SyncState::Catchup);
+        assert!(!should_skip_change(&map, 100, Some(120)).unwrap());
+    }
+
+    #[test]
+    fn catchup_uses_commit_order_and_an_inclusive_decoding_start() {
+        let map = mapping(SyncState::Catchup);
+        assert!(should_skip_change(&map, 80, Some(99)).unwrap());
+        assert!(!should_skip_change(&map, 80, Some(100)).unwrap());
+        assert!(!should_skip_change(&map, 80, Some(120)).unwrap());
+        assert!(should_skip_change(&map, 100, None).is_err());
+    }
+
+    #[test]
+    fn paused_snapshot_and_append_replay_retain_their_existing_rules() {
+        assert!(!should_skip_change(&mapping(SyncState::Snapshot), 80, Some(90)).unwrap());
+        let mut map = mapping(SyncState::Streaming);
+        assert!(!should_skip_change(&map, 109, Some(120)).unwrap());
+        map.sync_mode = SyncMode::Append;
+        assert!(should_skip_change(&map, 110, Some(120)).unwrap());
+        assert!(!should_skip_change(&map, 111, Some(120)).unwrap());
+        map.enabled = false;
+        assert!(should_skip_change(&map, 111, Some(120)).unwrap());
+    }
+}
